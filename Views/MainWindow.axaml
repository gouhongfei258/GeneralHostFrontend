<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeneralHostFrontend.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        x:Class="GeneralHostFrontend.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="General Host Framework">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Background="#F4F6F8">
        <Border Grid.Row="0" Background="#18202A" Padding="18,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                <StackPanel>
                    <TextBlock Text="General Host Framework" Foreground="White" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Avalonia industrial host client shell" Foreground="#B9C3CF" FontSize="12"/>
                </StackPanel>

                <ComboBox Grid.Column="1"
                          Width="180"
                          ItemsSource="{Binding WorkspaceOptions}"
                          SelectedItem="{Binding CurrentWorkspace}"/>

                <Button Grid.Column="2"
                        Command="{Binding StartCommand}"
                        Content="Start"
                        MinWidth="96"/>

                <Button Grid.Column="3"
                        Command="{Binding StopCommand}"
                        Content="Stop"
                        MinWidth="96"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="260,*" RowDefinitions="*" ColumnSpacing="12" Margin="12">
            <Border Grid.Column="0" Background="White" BorderBrush="#DAE0E6" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="14">
                    <TextBlock Text="Workspace" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                    <Border Background="#EEF3F7" CornerRadius="6" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding CurrentWorkspace}" FontSize="18" FontWeight="SemiBold" Foreground="#1D2733"/>
                            <TextBlock Text="{Binding RuntimeState}" Foreground="#516071"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Access" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                    <CheckBox Content="Force I/O" IsChecked="{Binding CanForceIo}" IsEnabled="False"/>
                    <CheckBox Content="Edit Settings" IsChecked="{Binding CanEditSettings}" IsEnabled="False"/>

                    <TextBlock Text="Runtime" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Command="{Binding StartCommand}"
                                Content="Start"
                                MinHeight="42"
                                Background="#0B6B5B"
                                Foreground="White"
                                FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Command="{Binding StopCommand}"
                                Content="Stop"
                                MinHeight="42"
                                Background="#8A2D3B"
                                Foreground="White"
                                FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock Text="Settings Health" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                    <TextBlock Text="Hot reload and validation ports are ready." TextWrapping="Wrap" Foreground="#516071"/>

                    <TextBlock Text="Tools" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                    <Button Command="{Binding OpenTagEditorCommand}"
                            Content="Open Tags"
                            MinHeight="40"
                            FontWeight="SemiBold"/>
                    <Button Command="{Binding OpenDatabaseViewerCommand}"
                            Content="Open Database"
                            MinHeight="40"
                            FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="2*,*" RowSpacing="12">
                <Border Grid.Row="0" Background="White" BorderBrush="#DAE0E6" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <TextBlock Text="Live Tags" FontSize="17" FontWeight="SemiBold" Foreground="#1D2733"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Tags}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="2*,*,Auto,*,*" Margin="0,5">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#243142"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#0B6B5B"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Unit}" Foreground="#6B7785" Margin="8,0"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Quality}" Foreground="#39485A"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss.fff}'}" Foreground="#6B7785" HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="White" BorderBrush="#DAE0E6" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBlock Text="Live Log Viewer" FontSize="17" FontWeight="SemiBold" Foreground="#1D2733"/>
                            <ComboBox Grid.Column="1"
                                      Width="150"
                                      ItemsSource="{Binding LogLevelOptions}"
                                      SelectedItem="{Binding SelectedLogLevel}"/>
                            <TextBox Grid.Column="2"
                                     Width="220"
                                     PlaceholderText="Keyword"
                                     Text="{Binding LogKeyword}"/>
                        </Grid>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Logs}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="110,110,140,*" Margin="0,3">
                                        <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="#6B7785"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="#39485A" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="#516071"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#1D2733" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</Window>
