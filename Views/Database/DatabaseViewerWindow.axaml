<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeneralHostFrontend.ViewModels.Database"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
        Width="1180"
        Height="740"
        MinWidth="920"
        MinHeight="600"
        x:Class="GeneralHostFrontend.Views.Database.DatabaseViewerWindow"
        x:DataType="vm:DatabaseViewerViewModel"
        Title="Embedded Database Viewer">

    <Design.DataContext>
        <vm:DatabaseViewerViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*" Background="{StaticResource AppBackgroundBrush}">
        <Border Grid.Row="0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel>
                    <TextBlock Text="Embedded Database Viewer" Foreground="{StaticResource AppTextBrush}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DatabaseFile}" Foreground="{StaticResource AppMutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding DatabaseStatus}" Foreground="{StaticResource AppMutedTextBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Command="{Binding RefreshCommand}" Content="Refresh" MinWidth="84"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="250,*" ColumnSpacing="12" Margin="12">
            <Border Grid.Column="0" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Text="Tables" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Tables}"
                             SelectedItem="{Binding SelectedTable}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource AppTextBrush}"/>
                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource AppMutedTextBrush}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource AppSurfaceBrush}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="220,150,140,220,Auto,Auto,*" ColumnSpacing="8">
                        <TextBox PlaceholderText="Search all columns" Text="{Binding Keyword}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding FilterColumns}"
                                  SelectedItem="{Binding FilterColumn}"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding FilterOperators}"
                                  SelectedValue="{Binding FilterOperator}"
                                  SelectedValueBinding="{Binding Value}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox Grid.Column="3" PlaceholderText="Filter value" Text="{Binding FilterValue}"/>
                        <Button Grid.Column="4" Command="{Binding ApplyFiltersCommand}" Content="Apply" MinWidth="72"/>
                        <Button Grid.Column="5" Command="{Binding ClearFiltersCommand}" Content="Clear" MinWidth="72"/>
                        <TextBlock Grid.Column="6" Text="{Binding PageInfo}" Foreground="{StaticResource AppMutedTextBrush}" TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <DataGrid x:Name="RowsGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding GridRows}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              CanUserResizeColumns="True"
                              CanUserReorderColumns="True"
                              RowHeight="30"
                              BorderBrush="{StaticResource AppBorderBrush}"
                              BorderThickness="1"
                              Background="{StaticResource AppSurfaceBrush}"/>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding LastExportPath}" Foreground="{StaticResource AppMutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Command="{Binding ExportCsvCommand}" Content="CSV" MinWidth="64"/>
                        <Button Grid.Column="2" Command="{Binding ExportExcelCommand}" Content="Excel" MinWidth="76"/>
                        <Button Grid.Column="3" Command="{Binding PreviousPageCommand}" Content="Prev" MinWidth="76"/>
                        <Button Grid.Column="4" Command="{Binding NextPageCommand}" Content="Next" MinWidth="76"/>
                        <TextBlock Grid.Column="5" Text="Page" Foreground="{StaticResource AppMutedTextBrush}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="6"
                                       Width="112"
                                       Minimum="1"
                                       Maximum="999999"
                                       Increment="1"
                                       Value="{Binding PageNumber}"/>
                        <Button Grid.Column="7" Command="{Binding GoToPageCommand}" Content="Go" MinWidth="58"/>
                        <TextBlock Grid.Column="8" Text="Page size" Foreground="{StaticResource AppMutedTextBrush}" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="9"
                                       Width="112"
                                       Minimum="1"
                                       Maximum="500"
                                       Increment="10"
                                       Value="{Binding PageSize}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
