<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GeneralHostFrontend.ViewModels.Hmi"
        xmlns:hmi="using:GeneralHostFrontend.Core.Hmi"
        xmlns:views="using:GeneralHostFrontend.Views.Hmi"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="780"
        Width="1180"
        Height="720"
        MinWidth="1060"
        MinHeight="680"
        x:Class="GeneralHostFrontend.Views.Hmi.HmiEditorWindow"
        x:DataType="vm:HmiEditorViewModel"
        Title="HMI Editor">

    <Design.DataContext>
        <vm:HmiEditorViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <DataTemplate x:Key="ValueTextTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid RowDefinitions="Auto,*" RowSpacing="4">
                    <TextBlock Text="{Binding Text}"
                               Foreground="#475569"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="6">
                        <TextBlock Text="{Binding DisplayValue}"
                                   Foreground="#0F766E"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Unit}"
                                   Foreground="#64748B"
                                   FontSize="12"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StateIndicatorTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                    <Ellipse Width="34"
                             Height="34"
                             Fill="{Binding StateBrush}"
                             Stroke="#334155"
                             StrokeThickness="1"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}"
                                   Foreground="#1E293B"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding State, StringFormat='State: {0}'}"
                                   Foreground="#64748B"
                                   FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CommandButtonTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Button Content="{Binding Text}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#E0F2FE"
                    BorderBrush="#7DD3FC"
                    Foreground="#075985"
                    FontWeight="SemiBold"/>
        </DataTemplate>

        <DataTemplate x:Key="RuntimeCommandButtonTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Button Content="{Binding Text}"
                    Command="{Binding $parent[Window].DataContext.RuntimePreview.ExecuteWidgetCommand}"
                    CommandParameter="{Binding}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#E0F2FE"
                    BorderBrush="#7DD3FC"
                    Foreground="#075985"
                    FontWeight="SemiBold"/>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <TextBlock Text="{Binding Text}"
                       Foreground="{Binding Foreground}"
                       FontSize="{Binding FontSize}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="InputBoxTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <TextBox Text="{Binding Text}"
                     PlaceholderText="{Binding Placeholder}"
                     VerticalContentAlignment="Center"/>
        </DataTemplate>

        <DataTemplate x:Key="SwitchButtonTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <ToggleSwitch IsChecked="{Binding State}"
                          Content="{Binding Text}"
                          OnContent="{Binding Text}"
                          OffContent="{Binding Text}"/>
        </DataTemplate>

        <DataTemplate x:Key="ImageTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Border Background="#F8FAFC"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1">
                <Grid>
                    <Image Source="{Binding ResolvedImageSource}" Stretch="Uniform"/>
                    <TextBlock Text="{Binding Text}"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RectangleTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Border Background="{Binding Background}"
                    BorderBrush="{Binding Border}"
                    BorderThickness="{Binding StrokeThickness}"
                    CornerRadius="{Binding CornerRadius}"/>
        </DataTemplate>

        <DataTemplate x:Key="EllipseTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Ellipse Fill="{Binding Background}"
                     Stroke="{Binding Border}"
                     StrokeThickness="{Binding StrokeThickness}"/>
        </DataTemplate>

        <DataTemplate x:Key="LineTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Grid>
                <Border Height="{Binding StrokeThickness}"
                        Background="{Binding Border}"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsHorizontalLine}"/>
                <Border Width="{Binding StrokeThickness}"
                        Background="{Binding Border}"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsVerticalLine}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ContainerTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Border Background="{Binding Background}"
                    BorderBrush="{Binding Border}"
                    BorderThickness="{Binding StrokeThickness}"
                    CornerRadius="{Binding CornerRadius}"
                    Padding="10">
                <TextBlock Text="{Binding Text}"
                           Foreground="#475569"
                           FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProgressBarTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="5">
                    <TextBlock Text="{Binding Text}" Foreground="#334155" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Foreground="{Binding Background}"/>
                    <TextBlock Grid.Row="2" Text="{Binding DisplayValue}" Foreground="#64748B" FontSize="11"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TrendChartTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                    <TextBlock Text="{Binding Text}" Foreground="#334155" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Row="1" BorderBrush="#CBD5E1" BorderThickness="0,0,0,1">
                        <Polyline Points="8,92 48,72 88,80 128,42 168,55 208,28 248,44 288,24"
                                  Stroke="#0F766E"
                                  StrokeThickness="2"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding DisplayValue, StringFormat='Latest: {0}'}" Foreground="#64748B" FontSize="11"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AlarmListTemplate" DataType="{x:Type vm:HmiWidgetViewModel}">
            <Border Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBlock Text="{Binding Text}" Foreground="#334155" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Row="1" Spacing="6">
                        <Border Background="#FEF3C7" Padding="8,5" CornerRadius="4">
                            <TextBlock Text="{Binding Level, StringFormat='Level: {0}'}" Foreground="#92400E"/>
                        </Border>
                        <TextBlock Text="{Binding DisplayValue}" Foreground="#64748B" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*" Background="#F4F6F8">
        <Border Grid.Row="0" Background="White" BorderBrush="#DAE0E6" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <StackPanel>
                    <TextBlock Text="HMI Editor" Foreground="#1D2733" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#516071" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding LoadCommand}" Content="Reload" MinWidth="78"/>
                <Button Grid.Column="2" Command="{Binding SaveCommand}" Content="Save" MinWidth="78"/>
                <Button Grid.Column="3" Command="{Binding ToggleRunModeCommand}" Content="Run/Edit" MinWidth="88"/>
                <TextBlock Grid.Column="4"
                           Text="{Binding IsRunMode, StringFormat='Run mode: {0}'}"
                           VerticalAlignment="Center"
                           Foreground="#516071"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="230,*,330" ColumnSpacing="12" Margin="12">
            <Border Grid.Column="0" Background="White" BorderBrush="#DAE0E6" BorderThickness="1" CornerRadius="8" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="10">
                    <TextBlock Text="Toolbox" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding ToolboxItems}"
                             SelectedItem="{Binding SelectedToolboxItem}"
                             MaxHeight="150">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HmiToolboxItemViewModel}">
                                <Grid RowDefinitions="Auto,Auto">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Category}" FontSize="11" Foreground="#64748B"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="2"
                            Command="{Binding AddWidgetCommand}"
                            Content="Add Widget"
                            MinHeight="38"
                            Background="#DDEFE9"
                            Foreground="#163B33"
                            BorderBrush="#9CCABE"
                            FontWeight="SemiBold"/>
                    <Button Grid.Row="3"
                            Command="{Binding DuplicateSelectedWidgetCommand}"
                            Content="Duplicate"
                            MinHeight="38"/>
                    <Button Grid.Row="4"
                            Command="{Binding DeleteSelectedWidgetCommand}"
                            Content="Delete Selected"
                            MinHeight="38"
                            Background="#F4E2E6"
                            Foreground="#56202A"
                            BorderBrush="#D4A8B1"
                            FontWeight="SemiBold"/>
                    <StackPanel Grid.Row="5" Spacing="6">
                        <TextBlock Text="Pages" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                        <ListBox ItemsSource="{Binding PageIds}"
                                 SelectedItem="{Binding SelectedPageId}"
                                 MaxHeight="110"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Command="{Binding NewPageCommand}"
                                    Content="New"
                                    IsEnabled="{Binding CanRunPageOperation}"
                                    MinHeight="32"/>
                            <Button Grid.Column="1"
                                    Command="{Binding DeletePageCommand}"
                                    Content="Delete"
                                    IsEnabled="{Binding CanRunPageOperation}"
                                    MinHeight="32"
                                    Background="#F4E2E6"
                                    Foreground="#56202A"
                                    BorderBrush="#D4A8B1"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="6" Spacing="6">
                        <TextBlock Text="Grid" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                        <CheckBox Content="Show grid" IsChecked="{Binding IsGridVisible}"/>
                        <CheckBox Content="Snap to grid" IsChecked="{Binding SnapToGrid}"/>
                        <NumericUpDown Value="{Binding GridSize}" Minimum="4" Maximum="128"/>
                    </StackPanel>
                    <StackPanel Grid.Row="7" Spacing="6">
                        <TextBlock Text="Resources" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                        <ListBox ItemsSource="{Binding Resources}"
                                 SelectedItem="{Binding SelectedResource}"
                                 MaxHeight="86">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HmiResourceViewModel}">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Text="{Binding RelativePath}" FontSize="11" Foreground="#64748B"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Command="{Binding ApplySelectedResourceCommand}"
                                Content="Apply Resource"
                                MinHeight="32"/>
                    </StackPanel>
                    <StackPanel Grid.Row="8" Spacing="6">
                        <TextBlock Text="Templates" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                        <ListBox ItemsSource="{Binding Templates}"
                                 SelectedItem="{Binding SelectedTemplate}"
                                 MaxHeight="86">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HmiTemplateViewModel}">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="11" Foreground="#64748B"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Command="{Binding SaveSelectionAsTemplateCommand}"
                                    Content="Save"
                                    MinHeight="32"/>
                            <Button Grid.Column="1"
                                    Command="{Binding InsertSelectedTemplateCommand}"
                                    Content="Insert"
                                    MinHeight="32"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="9" Spacing="8">
                        <TextBlock Text="Page" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                        <TextBlock Text="Id" Foreground="#516071" FontSize="11"/>
                        <TextBox Text="{Binding PageId}" IsReadOnly="True"/>
                        <TextBlock Text="Name" Foreground="#516071" FontSize="11"/>
                        <TextBox Text="{Binding PageName}"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <StackPanel>
                                <TextBlock Text="Width" Foreground="#516071" FontSize="11"/>
                                <NumericUpDown Value="{Binding PageWidth}" Minimum="320" Maximum="4096"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Height" Foreground="#516071" FontSize="11"/>
                                <NumericUpDown Value="{Binding PageHeight}" Minimum="240" Maximum="4096"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="#E2E8F0" BorderBrush="#DAE0E6" BorderThickness="1" CornerRadius="8">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="24"
                          Width="{Binding PageWidth}"
                          Height="{Binding PageHeight}">
                    <Border Background="{Binding RuntimePreview.PageBackground}"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Width="{Binding RuntimePreview.PageWidth}"
                            Height="{Binding RuntimePreview.PageHeight}"
                            IsVisible="{Binding IsRunMode}">
                        <Canvas Width="{Binding RuntimePreview.PageWidth}"
                                Height="{Binding RuntimePreview.PageHeight}">
                            <ItemsControl ItemsSource="{Binding RuntimePreview.Widgets}"
                                          Width="{Binding RuntimePreview.PageWidth}"
                                          Height="{Binding RuntimePreview.PageHeight}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding $parent[ItemsControl].DataContext.RuntimePreview.PageWidth}"
                                                Height="{Binding $parent[ItemsControl].DataContext.RuntimePreview.PageHeight}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter">
                                        <Setter Property="views:DesignerCanvasBehavior.IsWidgetContainerEnabled" Value="True"/>
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HmiWidgetViewModel}">
                                        <Grid Width="{Binding Width}"
                                              Height="{Binding Height}">
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource ValueTextTemplate}"
                                                            IsVisible="{Binding IsValueText}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource StateIndicatorTemplate}"
                                                            IsVisible="{Binding IsStateIndicator}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource RuntimeCommandButtonTemplate}"
                                                            IsVisible="{Binding IsCommandButton}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource TextTemplate}"
                                                            IsVisible="{Binding IsText}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource InputBoxTemplate}"
                                                            IsVisible="{Binding IsInputBox}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource SwitchButtonTemplate}"
                                                            IsVisible="{Binding IsSwitchButton}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource ImageTemplate}"
                                                            IsVisible="{Binding IsImage}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource RectangleTemplate}"
                                                            IsVisible="{Binding IsRectangle}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource EllipseTemplate}"
                                                            IsVisible="{Binding IsEllipse}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource LineTemplate}"
                                                            IsVisible="{Binding IsLine}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource ContainerTemplate}"
                                                            IsVisible="{Binding IsContainer}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource ProgressBarTemplate}"
                                                            IsVisible="{Binding IsProgressBar}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource TrendChartTemplate}"
                                                            IsVisible="{Binding IsTrendChart}"/>
                                            <ContentControl Content="{Binding}"
                                                            ContentTemplate="{StaticResource AlarmListTemplate}"
                                                            IsVisible="{Binding IsAlarmList}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>

                    <Border
                            Background="{Binding PageBackground}"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            Width="{Binding PageWidth}"
                            Height="{Binding PageHeight}"
                            IsVisible="{Binding IsEditMode}">
                        <Canvas Width="{Binding PageWidth}"
                                Height="{Binding PageHeight}"
                                views:DesignerCanvasBehavior.IsSelectionSurfaceEnabled="True">
                            <ItemsControl ItemsSource="{Binding GridLines}"
                                          Width="{Binding PageWidth}"
                                          Height="{Binding PageHeight}"
                                          IsVisible="{Binding IsGridVisible}"
                                          IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding $parent[ItemsControl].DataContext.PageWidth}"
                                                Height="{Binding $parent[ItemsControl].DataContext.PageHeight}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter">
                                        <Setter Property="views:DesignerCanvasBehavior.IsGridLineContainerEnabled" Value="True"/>
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HmiGridLineViewModel}">
                                        <Border Background="#E2E8F0"
                                                Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                IsHitTestVisible="False"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Widgets}"
                                          Width="{Binding PageWidth}"
                                          Height="{Binding PageHeight}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding $parent[ItemsControl].DataContext.PageWidth}"
                                                Height="{Binding $parent[ItemsControl].DataContext.PageHeight}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Styles>
                                    <Style Selector="ContentPresenter">
                                        <Setter Property="views:DesignerCanvasBehavior.IsWidgetContainerEnabled" Value="True"/>
                                    </Style>
                                </ItemsControl.Styles>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HmiWidgetViewModel}">
                                        <Border Classes.selected-frame="{Binding IsSelected}"
                                                Classes.primary-frame="{Binding IsPrimarySelected}"
                                                BorderBrush="Transparent"
                                                BorderThickness="2"
                                                Padding="2"
                                                Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                views:DesignerCanvasBehavior.IsDragEnabled="True">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                                                </Style>
                                                <Style Selector="Border.selected-frame">
                                                    <Setter Property="BorderBrush" Value="#0F766E"/>
                                                </Style>
                                                <Style Selector="Border.primary-frame">
                                                    <Setter Property="BorderBrush" Value="#0EA5E9"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource ValueTextTemplate}"
                                                                IsVisible="{Binding IsValueText}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource StateIndicatorTemplate}"
                                                                IsVisible="{Binding IsStateIndicator}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource CommandButtonTemplate}"
                                                                IsVisible="{Binding IsCommandButton}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource TextTemplate}"
                                                                IsVisible="{Binding IsText}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource InputBoxTemplate}"
                                                                IsVisible="{Binding IsInputBox}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource SwitchButtonTemplate}"
                                                                IsVisible="{Binding IsSwitchButton}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource ImageTemplate}"
                                                                IsVisible="{Binding IsImage}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource RectangleTemplate}"
                                                                IsVisible="{Binding IsRectangle}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource EllipseTemplate}"
                                                                IsVisible="{Binding IsEllipse}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource LineTemplate}"
                                                                IsVisible="{Binding IsLine}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource ContainerTemplate}"
                                                                IsVisible="{Binding IsContainer}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource ProgressBarTemplate}"
                                                                IsVisible="{Binding IsProgressBar}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource TrendChartTemplate}"
                                                                IsVisible="{Binding IsTrendChart}"/>
                                                <ContentControl Content="{Binding}"
                                                                ContentTemplate="{StaticResource AlarmListTemplate}"
                                                                IsVisible="{Binding IsAlarmList}"/>
                                                <Border Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Background="#0F766E"
                                                        BorderBrush="White"
                                                        BorderThickness="1"
                                                        Cursor="BottomRightCorner"
                                                        IsVisible="{Binding IsSelected}"
                                                        views:DesignerCanvasBehavior.IsResizeHandle="True"
                                                        views:DesignerCanvasBehavior.IsResizeEnabled="True"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </Border>
                    </Grid>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DAE0E6" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <TextBlock Text="Properties" FontSize="15" FontWeight="SemiBold" Foreground="#1D2733"/>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="9">
                            <TextBlock Text="{Binding SelectedWidget.KindText}" Foreground="#516071"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Text="X" Foreground="#516071" FontSize="11"/>
                                    <NumericUpDown Value="{Binding SelectedWidget.X}" Minimum="0" Maximum="4096"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Y" Foreground="#516071" FontSize="11"/>
                                    <NumericUpDown Value="{Binding SelectedWidget.Y}" Minimum="0" Maximum="4096"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <StackPanel>
                                    <TextBlock Text="Width" Foreground="#516071" FontSize="11"/>
                                    <NumericUpDown Value="{Binding SelectedWidget.Width}" Minimum="24" Maximum="2048"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Height" Foreground="#516071" FontSize="11"/>
                                    <NumericUpDown Value="{Binding SelectedWidget.Height}" Minimum="24" Maximum="2048"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Command="{Binding BringForwardCommand}" Content="Forward"/>
                                <Button Grid.Column="1" Command="{Binding SendBackwardCommand}" Content="Backward"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Command="{Binding BringToFrontCommand}" Content="To Front"/>
                                <Button Grid.Column="1" Command="{Binding SendToBackCommand}" Content="To Back"/>
                            </Grid>
                            <TextBlock Text="Align" Foreground="#516071" FontSize="11"/>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                                <Button Command="{Binding AlignLeftCommand}" Content="Left"/>
                                <Button Grid.Column="1" Command="{Binding AlignRightCommand}" Content="Right"/>
                                <Button Grid.Row="1" Command="{Binding AlignTopCommand}" Content="Top"/>
                                <Button Grid.Row="1" Grid.Column="1" Command="{Binding AlignBottomCommand}" Content="Bottom"/>
                            </Grid>
                            <TextBlock Text="Bindings" FontWeight="SemiBold" Foreground="#1D2733"/>
                            <ItemsControl ItemsSource="{Binding BindingEditors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HmiBindingEditorViewModel}">
                                        <StackPanel Spacing="4" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#516071" FontSize="11"/>
                                            <AutoCompleteBox Text="{Binding TagName}"
                                                             ItemsSource="{Binding TagOptions}"
                                                             PlaceholderText="Tag name"
                                                             MinimumPrefixLength="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Properties" FontWeight="SemiBold" Foreground="#1D2733"/>
                            <ItemsControl ItemsSource="{Binding PropertyEditors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:HmiPropertyEditorViewModel}">
                                        <StackPanel Spacing="4" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#516071" FontSize="11"/>
                                            <TextBox Text="{Binding Value}" IsVisible="{Binding IsTextEditor}"/>
                                            <NumericUpDown Value="{Binding NumericValue}" IsVisible="{Binding IsNumberEditor}"/>
                                            <CheckBox IsChecked="{Binding BooleanValue}" IsVisible="{Binding IsBooleanEditor}"/>
                                            <ComboBox ItemsSource="{Binding Options}"
                                                      SelectedItem="{Binding Value}"
                                                      IsVisible="{Binding IsEnumEditor}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
